@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
    bool hasError = !ViewData.ModelState.IsValid;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — HRM System</title>
    <style>
        :root {
            --primary-500:#3b82f6; --primary-600:#2563eb; --primary-700:#1d4ed8;
            --error-50:#fef2f2;    --error-500:#dc2626;   --error-600:#b91c1c;
            --gray-200:#e2e8f0;    --gray-300:#cbd5e1;    --gray-400:#94a3b8;
            --gray-500:#64748b;    --gray-600:#475569;    --gray-900:#0f172a;
            --font:-apple-system,BlinkMacSystemFont,'Segoe UI','Roboto',sans-serif;
            --r-md:8px; --r-lg:12px;
        }
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

        body {
            font-family: var(--font); min-height:100vh;
            display:flex; align-items:stretch;
            background: linear-gradient(to right,#0c1d5e 0%,#1d4ed8 40%,#3b82f6 68%,#bfdbfe 100%);
            background-attachment: fixed; overflow:hidden; position:relative;
        }
        body::before {
            content:''; position:fixed; width:600px; height:600px; border-radius:50%;
            background:rgba(255,255,255,0.05); top:-200px; left:-150px; pointer-events:none;
        }
        body::after {
            content:''; position:fixed; width:450px; height:450px; border-radius:50%;
            background:rgba(255,255,255,0.04); bottom:-100px; right:-100px; pointer-events:none;
        }

        /* LEFT */
        .left {
            width:70%; display:flex; flex-direction:column; justify-content:center;
            padding:60px 72px 60px 64px; position:relative; z-index:1;
        }
        .left-inner { max-width:620px; }

        .brand { display:flex; align-items:center; gap:14px; margin-bottom:48px; }
        .brand-icon {
            width:52px; height:52px; border-radius:var(--r-lg); flex-shrink:0;
            background:rgba(255,255,255,0.18); border:1.5px solid rgba(255,255,255,0.35);
            display:flex; align-items:center; justify-content:center;
        }
        .brand-icon svg { width:28px; height:28px; stroke:#fff; fill:none; stroke-width:2; }
        .brand-name { font-size:22px; font-weight:700; color:#fff; line-height:1.1; }
        .brand-sub  { font-size:12px; color:rgba(255,255,255,0.65); margin-top:3px; }

        .hero-title {
            font-size:34px; font-weight:800; color:#fff; line-height:1.2;
            margin-bottom:16px; letter-spacing:-0.5px;
        }
        .hero-title span { color:rgba(255,255,255,0.75); }
        .hero-desc {
            font-size:15px; color:rgba(255,255,255,0.72);
            line-height:1.7; margin-bottom:48px; max-width:480px;
        }

        .features { display:flex; flex-direction:column; gap:16px; }
        .feat {
            display:flex; align-items:center; gap:14px;
            background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.12);
            border-radius:var(--r-lg); padding:14px 18px; transition:background .2s;
        }
        .feat:hover { background:rgba(255,255,255,0.13); }
        .feat-icon {
            width:38px; height:38px; border-radius:var(--r-md); flex-shrink:0;
            background:rgba(255,255,255,0.15); display:flex; align-items:center; justify-content:center;
        }
        .feat-icon svg { width:18px; height:18px; stroke:#fff; fill:none; stroke-width:2; }
        .feat-title { font-size:13px; font-weight:600; color:#fff; margin-bottom:2px; }
        .feat-desc  { font-size:12px; color:rgba(255,255,255,0.60); }
        .left-foot  { margin-top:auto; padding-top:48px; font-size:12px; color:rgba(255,255,255,0.35); }

        /* RIGHT */
        .right {
            width:30%; flex-shrink:0;
            display:flex; align-items:center; justify-content:center;
            padding:48px 44px 48px 24px; position:relative; z-index:1;
        }
        .glass-card {
            width:100%; background:rgba(255,255,255,0.82);
            backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px);
            border:1px solid rgba(255,255,255,0.70); border-radius:20px;
            box-shadow:0 16px 48px rgba(29,78,216,0.18), inset 0 1px 0 rgba(255,255,255,0.9);
            overflow:hidden;
        }

        .card-top { padding:32px 32px 24px; text-align:center; }
        .card-top-icon {
            width:52px; height:52px; border-radius:var(--r-lg); margin:0 auto 14px;
            background:linear-gradient(135deg,var(--primary-500),var(--primary-700));
            display:flex; align-items:center; justify-content:center;
            box-shadow:0 6px 16px rgba(37,99,235,0.30);
        }
        .card-top-icon svg { width:26px; height:26px; stroke:#fff; fill:none; stroke-width:2; }
        .card-title { font-size:21px; font-weight:800; color:var(--gray-900); margin-bottom:4px; }
        .card-sub   { font-size:13px; color:var(--gray-500); }

        .card-body { padding:0 32px 24px; }

        .alert-err {
            display:flex; align-items:flex-start; gap:10px;
            background:var(--error-50); border:1px solid #fecaca;
            border-radius:var(--r-md); padding:10px 14px; margin-bottom:20px;
        }
        .alert-err svg { width:17px; height:17px; stroke:var(--error-500); fill:none; stroke-width:2; flex-shrink:0; margin-top:1px; }
        .alert-err span { font-size:13px; color:var(--error-600); }

        .fg { margin-bottom:16px; }
        .fg label {
            display:block; font-size:12px; font-weight:600; color:var(--gray-600);
            margin-bottom:6px; text-transform:uppercase; letter-spacing:0.04em;
        }
        .input-wrap { position:relative; }
        .ico { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--gray-400); pointer-events:none; }
        .ico svg { width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2; }
        .fi {
            width:100%; height:44px; padding:0 14px 0 40px;
            border:1.5px solid var(--gray-300); border-radius:var(--r-md);
            font-size:14px; color:var(--gray-900); background:rgba(248,250,252,0.8);
            font-family:var(--font); outline:none; transition:all .18s;
        }
        .fi::placeholder { color:var(--gray-400); }
        .fi:focus { border-color:var(--primary-500); background:#fff; box-shadow:0 0 0 3px rgba(59,130,246,0.12); }
        .fi.is-invalid { border-color:var(--error-500); background:var(--error-50); }
        .err-msg { font-size:11px; color:var(--error-500); margin-top:4px; }

        .btn-login {
            width:100%; height:46px; border:none; border-radius:var(--r-md);
            background:linear-gradient(135deg,var(--primary-500),var(--primary-700));
            color:#fff; font-size:15px; font-weight:700; cursor:pointer;
            display:flex; align-items:center; justify-content:center; gap:8px;
            font-family:var(--font); transition:all .2s;
            box-shadow:0 4px 16px rgba(29,78,216,0.35);
        }
        .btn-login svg { width:17px; height:17px; stroke:#fff; fill:none; stroke-width:2; }
        .btn-login:hover { background:linear-gradient(135deg,var(--primary-600),#1e3a8a); transform:translateY(-1px); box-shadow:0 8px 24px rgba(29,78,216,0.40); }

        .card-foot {
            padding:14px 32px; border-top:1px solid rgba(226,232,240,0.6);
            background:rgba(248,250,252,0.50); text-align:center;
        }
        .card-foot p { font-size:11px; color:var(--gray-400); }

        @@media (max-width: 900px) {
            .left { display:none; }
            .right { width:100%; padding:40px 24px; }
            .glass-card { max-width:420px; margin:0 auto; }
        }
    </style>
</head>
<body>

<!-- LEFT: Branding -->
<div class="left">
    <div class="left-inner">
        <div class="brand">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
                <div class="brand-name">UTC HRM System</div>
                <div class="brand-sub">Nhóm 29K1 — Môn Lập trình Web .NET</div>
            </div>
        </div>

        <h1 class="hero-title">Quản lý nhân sự<br><span>toàn diện &amp; hiệu quả</span></h1>
        <p class="hero-desc">
            Nền tảng quản lý nhân sự hiện đại — số hóa toàn bộ quy trình từ hồ sơ nhân viên,
            hợp đồng lao động đến phụ cấp, giúp phòng HR tiết kiệm thời gian và giảm sai sót.
        </p>

        <div class="features">
            <div class="feat">
                <div class="feat-icon">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                </div>
                <div>
                    <div class="feat-title">Quản lý hồ sơ nhân viên</div>
                    <div class="feat-desc">Lưu trữ, tìm kiếm và cập nhật thông tin nhân viên tập trung</div>
                </div>
            </div>
            <div class="feat">
                <div class="feat-icon">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
                </div>
                <div>
                    <div class="feat-title">Theo dõi hợp đồng lao động</div>
                    <div class="feat-desc">Quản lý vòng đời hợp đồng, lương cơ bản và lương thỏa thuận</div>
                </div>
            </div>
            <div class="feat">
                <div class="feat-icon">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                    <div class="feat-title">Quản lý phụ cấp &amp; người phụ thuộc</div>
                    <div class="feat-desc">Gán phụ cấp theo hợp đồng, theo dõi người phụ thuộc giảm trừ thuế</div>
                </div>
            </div>
            <div class="feat">
                <div class="feat-icon">
                    <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div>
                    <div class="feat-title">Phân quyền HR Manager / Nhân viên</div>
                    <div class="feat-desc">Mỗi vai trò chỉ thấy đúng chức năng cần thiết, bảo mật dữ liệu</div>
                </div>
            </div>
        </div>

        <div class="left-foot">© 2026 UTC HRM System · v1.0.0</div>
    </div>
</div>

<!-- RIGHT: Glass Form -->
<div class="right">
    <div class="glass-card">
        <div class="card-top">
            <div class="card-top-icon">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="card-title">Đăng nhập</div>
            <div class="card-sub">Nhập tài khoản để tiếp tục sử dụng hệ thống</div>
        </div>

        <div class="card-body">
            @if (hasError)
            {
                <div class="alert-err">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span asp-validation-summary="All"></span>
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div class="fg">
                    <label asp-for="Username">Tên đăng nhập</label>
                    <div class="input-wrap">
                        <span class="ico"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
                        <input asp-for="Username" class="fi @(hasError ? "is-invalid" : "")"
                               placeholder="Nhập tên đăng nhập" autofocus autocomplete="username" />
                    </div>
                    <span asp-validation-for="Username" class="err-msg"></span>
                </div>

                <div class="fg">
                    <label asp-for="Password">Mật khẩu</label>
                    <div class="input-wrap">
                        <span class="ico"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                        <input asp-for="Password" class="fi" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="err-msg"></span>
                </div>

                <button type="submit" class="btn-login">
                    <svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    Đăng nhập
                </button>
            </form>
        </div>

        <div class="card-foot">
            <p>UTC29K1 HRM System &copy; 2026 &nbsp;·&nbsp; Môn Lập trình Web .NET</p>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
