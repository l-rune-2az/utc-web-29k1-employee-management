@model AllowanceConfigDetailViewModel
@{
    ViewData["Title"] = "Chi tiết phụ cấp";
    var cfg = Model.Config;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-icon btn-outline-secondary me-2" title="Quay lại">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <span class="fw-bold fs-5">@cfg.Name</span>
        <code class="ms-2">@cfg.Code</code>
        <span class="badge ms-2 @(cfg.Status == "ACTIVE" ? "badge-active" : "badge-inactive")">
            @(cfg.Status == "ACTIVE" ? "Hoạt động" : "Không HĐ")
        </span>
    </div>
    <a asp-action="Edit" asp-route-id="@cfg.Id" class="btn btn-primary btn-sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" class="me-1"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Chỉnh sửa
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom py-3">Thông tin loại phụ cấp</div>
    <div class="card-body">
        <dl class="row mb-0 g-2">
            <dt class="col-sm-3 text-muted fw-normal">Mức mặc định</dt>
            <dd class="col-sm-9 fw-semibold">@(cfg.DefaultAmount.HasValue ? $"{cfg.DefaultAmount.Value:N0} ₫" : "-- Tùy từng trường hợp")</dd>
            <dt class="col-sm-3 text-muted fw-normal">Mô tả</dt>
            <dd class="col-sm-9">@(cfg.Description ?? "--")</dd>
            <dt class="col-sm-3 text-muted fw-normal">Cập nhật lần cuối</dt>
            <dd class="col-sm-9">@(cfg.UpdatedAt.HasValue ? cfg.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "--")</dd>
            <dt class="col-sm-3 text-muted fw-normal">Người cập nhật</dt>
            <dd class="col-sm-9">@(cfg.UpdatedBy ?? "--")</dd>
        </dl>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom py-3">
        Đang áp dụng cho <span class="badge bg-secondary ms-1">@Model.Usages.Count(u => u.Status == "ACTIVE")</span> nhân viên
        <span class="text-muted small ms-2">(tổng @Model.Usages.Count bản ghi)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Nhân viên</th><th>Hợp đồng</th><th>Số tiền</th><th>Ngày áp dụng</th><th>Trạng thái</th><th style="width:48px"></th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Usages.OrderByDescending(x => x.EffectiveDate))
                {
                    <tr>
                        <td class="fw-semibold">@(u.Employee?.FullName ?? "--")</td>
                        <td><code>@(u.Contract?.ContractNumber ?? "--")</code></td>
                        <td>@u.Amount.ToString("N0") ₫</td>
                        <td>@(u.EffectiveDate.HasValue ? u.EffectiveDate.Value.ToString("dd/MM/yyyy") : "--")</td>
                        <td><span class="badge @(u.Status == "ACTIVE" ? "badge-active" : "badge-inactive")">@(u.Status == "ACTIVE" ? "Đang áp dụng" : "Đã dừng")</span></td>
                        <td><a asp-controller="EmployeeAllowance" asp-action="Edit" asp-route-id="@u.Id" class="btn btn-icon btn-outline-primary" title="Sửa">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </a></td>
                    </tr>
                }
                @if (!Model.Usages.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có nhân viên nào dùng phụ cấp này</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
