@model AllowanceConfigFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa loại phụ cấp";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Chỉnh sửa loại phụ cấp</h4>
        <p class="text-muted mb-0" style="font-size:14px">Cập nhật thông tin danh mục phụ cấp</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Quay lại
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                <form id="editForm" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label">Mã phụ cấp</label>
                            <input asp-for="Code" class="form-control" />
                            <span asp-validation-for="Code" class="text-danger" style="font-size:12px"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label">Tên loại phụ cấp</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size:12px"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DefaultAmount" class="form-label">Mức mặc định (VNĐ)</label>
                        <input asp-for="DefaultAmount" type="number" class="form-control" step="10000" min="0" />
                        <div class="form-text">Có thể thay đổi khi gán cho từng nhân viên.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary px-4">Cập nhật</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm guide-card">
            <div class="card-header">
                <span class="fw-semibold" style="color:#334155">Lưu ý</span>
            </div>
            <div class="card-body">
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    Thay đổi mức mặc định <strong>không ảnh hưởng</strong> đến phụ cấp đã gán cho nhân viên.
                </div>
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Mã phụ cấp phải duy nhất trong hệ thống.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('editForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = new FormData(this);
    const payload = {};
    data.forEach((value, key) => { if (key !== '__RequestVerificationToken') payload[key] = value; });
    this.querySelectorAll('input[type="number"]').forEach(function(input) {
        if (!input.name) return;
        payload[input.name] = payload[input.name] !== '' ? parseFloat(payload[input.name]) : null;
    });
    try {
        const res = await fetch('/api/allowance-configs/@Model.Id', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (res.ok) window.location.href = '@Url.Action("Index")';
        else { const d = await res.json(); alert(d.error || 'Có lỗi xảy ra'); }
    } catch { alert('Có lỗi kết nối'); }
});
</script>
}
