@model ContractFormViewModel
@{
    ViewData["Title"] = "Thêm hợp đồng mới";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Thêm hợp đồng mới</h4>
        <p class="text-muted mb-0" style="font-size:14px">Ký kết hợp đồng lao động với nhân viên</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Quay lại
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <p class="form-section">Thông tin chung</p>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="EmpId" class="form-label">Nhân viên</label>
                            <select asp-for="EmpId" asp-items="Model.EmployeeOptions" class="form-select"></select>
                            <span asp-validation-for="EmpId" class="text-danger" style="font-size:12px"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ContractType" class="form-label">Loại hợp đồng</label>
                            <select asp-for="ContractType" asp-items="Model.ContractTypeOptions" class="form-select"></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="SalaryType" class="form-label">Loại lương</label>
                            <select asp-for="SalaryType" asp-items="Model.SalaryTypeOptions" class="form-select"></select>
                        </div>
                    </div>

                    <p class="form-section">Thời hạn & Lương</p>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger" style="font-size:12px"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <div class="form-text">Để trống = không xác định</div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="BaseSalary" class="form-label">Lương cơ bản (₫)</label>
                            <input asp-for="BaseSalary" type="number" class="form-control" step="100000" min="0" />
                            <span asp-validation-for="BaseSalary" class="text-danger" style="font-size:12px"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="OfferSalary" class="form-label">Lương thỏa thuận (₫)</label>
                            <input asp-for="OfferSalary" type="number" class="form-control" step="100000" min="0" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label">Ghi chú</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ghi chú thêm về hợp đồng"></textarea>
                    </div>

                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary px-4">Lưu hợp đồng</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm guide-card">
            <div class="card-header">
                <span class="fw-semibold" style="color:#334155">Lưu ý</span>
            </div>
            <div class="card-body">
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Số hợp đồng sẽ được <strong>tự động tạo</strong> theo quy tắc của hệ thống.
                </div>
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Một nhân viên có thể có <strong>nhiều hợp đồng</strong> (thử việc → chính thức).
                </div>
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Ngày kết thúc để trống = hợp đồng <strong>không xác định thời hạn</strong>.
                </div>
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Loại: <strong>Thử việc</strong> (2 tháng), <strong>Thời vụ</strong>, <strong>Chính thức</strong>.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
