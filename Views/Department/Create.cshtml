@model DepartmentFormViewModel
@{
    ViewData["Title"] = "Thêm phòng ban mới";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Thêm phòng ban mới</h4>
        <p class="text-muted mb-0" style="font-size:14px">Tạo đơn vị tổ chức mới trong cây phòng ban</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Quay lại
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label">Mã phòng ban</label>
                            <input asp-for="Code" class="form-control" placeholder="VD: IT, HR, KT" />
                            <span asp-validation-for="Code" class="text-danger" style="font-size:12px"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label">Tên phòng ban</label>
                            <input asp-for="Name" class="form-control" placeholder="Tên đầy đủ phòng ban" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size:12px"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ParentId" class="form-label">Phòng ban cha</label>
                            <select asp-for="ParentId" asp-items="Model.ParentOptions" class="form-select"></select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Mô tả ngắn về phòng ban"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary px-4">Lưu</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm guide-card">
            <div class="card-header">
                <span class="fw-semibold" style="color:#334155">Lưu ý</span>
            </div>
            <div class="card-body">
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Mã phòng ban phải <strong>duy nhất</strong>, viết hoa không dấu (IT, HR, KT...).
                </div>
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Chọn <strong>phòng ban cha</strong> nếu đây là phòng ban con (bộ phận trực thuộc).
                </div>
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Phòng ban inactive sẽ <strong>không hiển thị</strong> khi thêm nhân viên mới.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
