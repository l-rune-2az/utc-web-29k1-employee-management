@model DepartmentDetailViewModel
@{
    ViewData["Title"] = "Chi tiết phòng ban";
    var dept = Model.Department;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-icon btn-outline-secondary me-2" title="Quay lại">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <span class="fw-bold fs-5">@dept.Name</span>
        <code class="ms-2">@dept.Code</code>
        <span class="badge ms-2 @(dept.Status == "ACTIVE" ? "badge-active" : "badge-inactive")">
            @(dept.Status == "ACTIVE" ? "Hoạt động" : "Không HĐ")
        </span>
    </div>
    <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-primary btn-sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" class="me-1"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Chỉnh sửa
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom py-3">Thông tin phòng ban</div>
    <div class="card-body">
        <dl class="row mb-0 g-2">
            <dt class="col-sm-3 text-muted fw-normal">Phòng ban cha</dt>
            <dd class="col-sm-9">@(dept.Parent?.Name ?? "--")</dd>
            <dt class="col-sm-3 text-muted fw-normal">Mô tả</dt>
            <dd class="col-sm-9">@(dept.Description ?? "--")</dd>
            <dt class="col-sm-3 text-muted fw-normal">Cập nhật lần cuối</dt>
            <dd class="col-sm-9">@(dept.UpdatedAt.HasValue ? dept.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "--")</dd>
            <dt class="col-sm-3 text-muted fw-normal">Người cập nhật</dt>
            <dd class="col-sm-9">@(dept.UpdatedBy ?? "--")</dd>
        </dl>
    </div>
</div>

@if (Model.SubDepartments.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header fw-semibold bg-transparent border-bottom py-3">
            Phòng ban con <span class="badge bg-secondary ms-1">@Model.SubDepartments.Count</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>Mã</th><th>Tên phòng ban</th><th>Trạng thái</th><th style="width:48px"></th></tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model.SubDepartments)
                    {
                        <tr>
                            <td><code>@sub.Code</code></td>
                            <td class="fw-semibold">@sub.Name</td>
                            <td><span class="badge @(sub.Status == "ACTIVE" ? "badge-active" : "badge-inactive")">@(sub.Status == "ACTIVE" ? "Hoạt động" : "Không HĐ")</span></td>
                            <td><a asp-action="Details" asp-route-id="@sub.Id" class="btn btn-icon btn-outline-secondary" title="Chi tiết">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom py-3">
        Nhân viên thuộc phòng ban <span class="badge bg-secondary ms-1">@Model.Employees.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Mã NV</th><th>Họ và tên</th><th>Chức vụ</th><th>Trạng thái</th><th style="width:48px"></th></tr>
            </thead>
            <tbody>
                @foreach (var emp in Model.Employees)
                {
                    <tr>
                        <td><code>@emp.Code</code></td>
                        <td class="fw-semibold">@emp.FullName</td>
                        <td>@(emp.Position?.Name ?? "--")</td>
                        <td><span class="badge @(emp.Status == "ACTIVE" ? "badge-active" : "badge-inactive")">@(emp.Status == "ACTIVE" ? "Đang làm" : "Đã nghỉ")</span></td>
                        <td><a asp-controller="Employee" asp-action="Details" asp-route-id="@emp.Id" class="btn btn-icon btn-outline-secondary" title="Chi tiết nhân viên">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </a></td>
                    </tr>
                }
                @if (!Model.Employees.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có nhân viên</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
