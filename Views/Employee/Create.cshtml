@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Thêm nhân viên mới";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Thêm nhân viên mới</h4>
        <p class="text-muted mb-0" style="font-size:14px">Nhập thông tin hồ sơ nhân viên</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Quay lại
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <p class="form-section">Thông tin cá nhân</p>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">Họ và tên</label>
                            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size:12px"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Gender" class="form-label">Giới tính</label>
                            <select asp-for="Gender" asp-items="Model.GenderOptions" class="form-select"></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="IdCard" class="form-label">CMND/CCCD</label>
                            <input asp-for="IdCard" class="form-control" placeholder="012345678901" />
                            <span asp-validation-for="IdCard" class="text-danger" style="font-size:12px"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="email@company.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:12px"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Phone" class="form-label">Điện thoại</label>
                            <input asp-for="Phone" class="form-control" placeholder="0912 345 678" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">Địa chỉ</label>
                            <input asp-for="Address" class="form-control" placeholder="Địa chỉ thường trú" />
                        </div>
                    </div>

                    <p class="form-section">Thông tin công việc</p>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="HireDate" class="form-label">Ngày vào làm</label>
                            <input asp-for="HireDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DeptId" class="form-label">Phòng ban</label>
                            <select asp-for="DeptId" asp-items="Model.DepartmentOptions" class="form-select"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PositionId" class="form-label">Chức vụ</label>
                            <select asp-for="PositionId" asp-items="Model.PositionOptions" class="form-select"></select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary px-4">Lưu nhân viên</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm guide-card">
            <div class="card-header">
                <span class="fw-semibold" style="color:#334155">Lưu ý</span>
            </div>
            <div class="card-body">
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Mã nhân viên sẽ được <strong>tự động tạo</strong> theo quy tắc của hệ thống.
                </div>
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Email phải <strong>duy nhất</strong> trong hệ thống.
                </div>
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Sau khi tạo, vào <strong>Hợp đồng</strong> để ký hợp đồng lao động cho nhân viên này.
                </div>
                <div class="guide-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Tài khoản đăng nhập sẽ được tự động tạo kèm theo.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
