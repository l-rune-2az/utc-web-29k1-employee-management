@model EmployeeDetailViewModel
@{
    ViewData["Title"] = "Hồ sơ nhân viên";
    var emp = Model.Employee;
    string genderText = emp.Gender switch { "MALE" => "Nam", "FEMALE" => "Nữ", _ => "Khác" };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-icon btn-outline-secondary me-2" title="Quay lại">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <span class="fw-bold fs-5">@emp.FullName</span>
        <code class="ms-2">@emp.Code</code>
        <span class="badge ms-2 @(emp.Status == "ACTIVE" ? "badge-active" : "badge-inactive")">
            @(emp.Status == "ACTIVE" ? "Đang làm việc" : "Đã nghỉ việc")
        </span>
    </div>
    <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-primary btn-sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" class="me-1"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Chỉnh sửa
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom py-3">Thông tin hồ sơ</div>
    <div class="card-body">
        <div class="row g-0">
            <div class="col-md-6">
                <dl class="row mb-0 g-2">
                    <dt class="col-5 text-muted fw-normal">Giới tính</dt>
                    <dd class="col-7">@genderText</dd>
                    <dt class="col-5 text-muted fw-normal">Ngày sinh</dt>
                    <dd class="col-7">@(emp.DateOfBirth.HasValue ? emp.DateOfBirth.Value.ToString("dd/MM/yyyy") : "--")</dd>
                    <dt class="col-5 text-muted fw-normal">CMND/CCCD</dt>
                    <dd class="col-7">@(emp.IdCard ?? "--")</dd>
                    <dt class="col-5 text-muted fw-normal">Email</dt>
                    <dd class="col-7">@emp.Email</dd>
                    <dt class="col-5 text-muted fw-normal">Điện thoại</dt>
                    <dd class="col-7">@(emp.Phone ?? "--")</dd>
                    <dt class="col-5 text-muted fw-normal">Địa chỉ</dt>
                    <dd class="col-7">@(emp.Address ?? "--")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row mb-0 g-2">
                    <dt class="col-5 text-muted fw-normal">Phòng ban</dt>
                    <dd class="col-7">@(emp.Department?.Name ?? "--")</dd>
                    <dt class="col-5 text-muted fw-normal">Chức vụ</dt>
                    <dd class="col-7">@(emp.Position?.Name ?? "--")</dd>
                    <dt class="col-5 text-muted fw-normal">Ngày vào làm</dt>
                    <dd class="col-7">@(emp.HireDate.HasValue ? emp.HireDate.Value.ToString("dd/MM/yyyy") : "--")</dd>
                    <dt class="col-5 text-muted fw-normal">Cập nhật lần cuối</dt>
                    <dd class="col-7">@(emp.UpdatedAt.HasValue ? emp.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "--")</dd>
                    <dt class="col-5 text-muted fw-normal">Người cập nhật</dt>
                    <dd class="col-7">@(emp.UpdatedBy ?? "--")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
        <span>Hợp đồng lao động <span class="badge bg-secondary ms-1">@Model.Contracts.Count</span></span>
        <a asp-controller="Contract" asp-action="Index" class="btn btn-sm btn-outline-primary">+ Thêm</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Số hợp đồng</th>
                    <th>Loại HĐ</th>
                    <th>Ngày bắt đầu</th>
                    <th>Ngày kết thúc</th>
                    <th>Lương cơ bản</th>
                    <th>Trạng thái</th>
                    <th style="width:48px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Contracts.OrderByDescending(x => x.StartDate))
                {
                    var (cls, txt) = c.Status switch
                    {
                        "ACTIVE"     => ("badge-active",     "Hiệu lực"),
                        "EXPIRED"    => ("badge-expired",    "Hết hạn"),
                        _            => ("badge-terminated", "Đã chấm dứt")
                    };
                    <tr>
                        <td><code>@c.ContractNumber</code></td>
                        <td>@(c.ContractType switch { "PROBATION" => "Thử việc", "SEASONAL" => "Thời vụ", _ => "Chính thức" })</td>
                        <td>@c.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@(c.EndDate.HasValue ? c.EndDate.Value.ToString("dd/MM/yyyy") : "Không thời hạn")</td>
                        <td>@c.BaseSalary.ToString("N0") ₫</td>
                        <td><span class="badge @cls">@txt</span></td>
                        <td class="text-end">
                            <a asp-controller="Contract" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-icon btn-outline-primary" title="Sửa">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Contracts.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Chưa có hợp đồng</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
        <span>Phụ cấp <span class="badge bg-secondary ms-1">@Model.Allowances.Count</span></span>
        <a asp-controller="EmployeeAllowance" asp-action="Index" class="btn btn-sm btn-outline-primary">+ Thêm</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Hợp đồng</th>
                    <th>Loại phụ cấp</th>
                    <th>Số tiền</th>
                    <th>Ngày áp dụng</th>
                    <th>Trạng thái</th>
                    <th style="width:48px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Allowances.OrderByDescending(x => x.EffectiveDate))
                {
                    <tr>
                        <td><code>@a.Contract?.ContractNumber</code></td>
                        <td>@a.AllowanceConfig?.Name</td>
                        <td class="fw-semibold">@a.Amount.ToString("N0") ₫</td>
                        <td>@(a.EffectiveDate.HasValue ? a.EffectiveDate.Value.ToString("dd/MM/yyyy") : "--")</td>
                        <td>
                            <span class="badge @(a.Status == "ACTIVE" ? "badge-active" : "badge-inactive")">
                                @(a.Status == "ACTIVE" ? "Đang áp dụng" : "Đã dừng")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="EmployeeAllowance" asp-action="Edit" asp-route-id="@a.Id" class="btn btn-icon btn-outline-primary" title="Sửa">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Allowances.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có phụ cấp</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
        <span>Người phụ thuộc <span class="badge bg-secondary ms-1">@Model.Dependents.Count</span></span>
        <a asp-controller="Dependent" asp-action="Index" class="btn btn-sm btn-outline-primary">+ Thêm</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Họ và tên</th>
                    <th>Mối quan hệ</th>
                    <th>Ngày sinh</th>
                    <th>CMND/CCCD</th>
                    <th>Trạng thái</th>
                    <th style="width:48px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Dependents)
                {
                    <tr>
                        <td class="fw-semibold">@d.FullName</td>
                        <td>@(d.Relationship switch { "SPOUSE" => "Vợ/Chồng", "CHILD" => "Con", "PARENT" => "Bố/Mẹ", _ => d.Relationship })</td>
                        <td>@(d.DateOfBirth.HasValue ? d.DateOfBirth.Value.ToString("dd/MM/yyyy") : "--")</td>
                        <td>@(d.NationalId ?? "--")</td>
                        <td>
                            <span class="badge @(d.Status == "ACTIVE" ? "badge-active" : "badge-inactive")">
                                @(d.Status == "ACTIVE" ? "Đang khai" : "Đã hủy")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="Dependent" asp-action="Edit" asp-route-id="@d.Id" class="btn btn-icon btn-outline-primary" title="Sửa">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Dependents.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có người phụ thuộc</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
