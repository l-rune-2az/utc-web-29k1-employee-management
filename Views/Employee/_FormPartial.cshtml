@model EmployeeFormViewModel
@{
    bool isEdit = Model.Id != Guid.Empty;
    string action = isEdit ? "Edit" : "Create";
}
<form asp-action="@action" asp-route-id="@(isEdit ? Model.Id.ToString() : null)"
      method="post">
    @Html.AntiForgeryToken()

    <p class="form-section">Thông tin cá nhân</p>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="FullName" class="form-label">Họ và tên</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger" style="font-size:12px"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Gender" class="form-label">Giới tính</label>
            <select asp-for="Gender" asp-items="Model.GenderOptions" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
            <input asp-for="DateOfBirth" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="IdCard" class="form-label">CMND/CCCD</label>
            <input asp-for="IdCard" class="form-control" />
            <span asp-validation-for="IdCard" class="text-danger" style="font-size:12px"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger" style="font-size:12px"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Phone" class="form-label">Điện thoại</label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Address" class="form-label">Địa chỉ</label>
            <input asp-for="Address" class="form-control" />
        </div>
    </div>

    <p class="form-section">Thông tin công việc</p>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="HireDate" class="form-label">Ngày vào làm</label>
            <input asp-for="HireDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="DeptId" class="form-label">Phòng ban</label>
            <select asp-for="DeptId" asp-items="Model.DepartmentOptions" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="PositionId" class="form-label">Chức vụ</label>
            <select asp-for="PositionId" asp-items="Model.PositionOptions" class="form-select"></select>
        </div>
    </div>

    <div class="d-flex gap-2 pt-3 border-top">
        <button type="submit" class="btn btn-primary px-4">@(isEdit ? "Cập nhật" : "Lưu")</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
    </div>
</form>
