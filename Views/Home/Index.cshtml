@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    bool isHr = User.IsInRole("HR_MANAGER");
}

<style>
    .stat-card {
        background: #fff; border-radius: 12px; border: 1px solid #e2e8f0;
        box-shadow: 0 1px 2px rgba(0,0,0,.05); padding: 20px;
        display: flex; flex-direction: row; align-items: center; gap: 14px;
        transition: all .3s; text-decoration: none; color: inherit; height: 100%;
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.1); color: inherit; }
    .stat-icon {
        width: 44px; height: 44px; border-radius: 10px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .stat-icon svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 2; }
    .stat-icon.blue   { background: #eff6ff; color: #2563eb; }
    .stat-icon.green  { background: #dcfce7; color: #166534; }
    .stat-icon.yellow { background: #fffbeb; color: #d97706; }
    .stat-icon.red    { background: #fef2f2; color: #dc2626; }
    .stat-icon.purple { background: #ede9fe; color: #7c3aed; }
    .stat-value { font-size: 26px; font-weight: 700; color: #0f172a; line-height: 1; }
    .stat-label { font-size: 13px; color: #64748b; margin-top: 2px; line-height: 1.4; }

    .quick-actions {
        background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 16px 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .quick-label { font-size: 14px; font-weight: 600; color: #475569; white-space: nowrap; margin-right: 4px; }
</style>

@if (isHr)
{
    <div class="mb-4">
        <h4 class="fw-bold mb-0" style="color:#0f172a">Dashboard</h4>
        <p class="text-muted mb-0" style="font-size:14px">Xin chào, <strong>@User.Identity?.Name</strong>! Dưới đây là tổng quan nhân sự.</p>
    </div>

    
    <div class="row row-cols-2 row-cols-md-5 g-3 mb-4">
        <div class="col">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                    <div class="stat-value">@Model.TotalEmployees</div>
                    <div class="stat-label">Tổng nhân viên</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card">
                <div class="stat-icon purple">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </div>
                <div>
                    <div class="stat-value">@Model.TotalDepartments</div>
                    <div class="stat-label">Phòng ban</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card">
                <div class="stat-icon green">
                    <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div>
                    <div class="stat-value">@Model.ActiveEmployees</div>
                    <div class="stat-label">Đang làm việc</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card">
                <div class="stat-icon yellow">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <div>
                    <div class="stat-value">@Model.ExpiringContracts</div>
                    <div class="stat-label">HĐ sắp hết hạn</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card">
                <div class="stat-icon red">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </div>
                <div>
                    <div class="stat-value">@Model.InactiveEmployees</div>
                    <div class="stat-label">Nhân viên nghỉ việc</div>
                </div>
            </div>
        </div>
    </div>

    
    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="mb-0 fw-semibold" style="color:#374151">Tăng trưởng nhân sự</h6>
                    <span class="text-muted" style="font-size:12px">Headcount tích lũy 6 tháng gần nhất</span>
                </div>
                <div class="card-body" style="min-height:220px">
                    <canvas id="growthChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="mb-0 fw-semibold" style="color:#374151">Tuyển dụng theo phòng ban</h6>
                    <span class="text-muted" style="font-size:12px">Nhân viên mới mỗi tháng trong 6 tháng gần nhất</span>
                </div>
                <div class="card-body" style="min-height:220px">
                    <canvas id="deptChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h6 class="mb-0 fw-semibold">Nhân viên mới nhất</h6>
            <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-outline-primary" style="font-size:12px">Xem tất cả</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Mã NV</th>
                        <th>Họ và tên</th>
                        <th>Phòng ban</th>
                        <th>Chức vụ</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentEmployees.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Dữ liệu trống</td></tr>
                    }
                    @foreach (Employee emp in Model.RecentEmployees)
                    {
                        <tr>
                            <td><span style="color:#2563eb;font-weight:600;">@emp.Code</span></td>
                            <td class="fw-semibold">@emp.FullName</td>
                            <td>@(emp.Department?.Name ?? "--")</td>
                            <td>@(emp.Position?.Name ?? "--")</td>
                            <td class="text-center">
                                <span class="badge @(emp.Status == "ACTIVE" ? "badge-active" : "badge-inactive")"
                                      style="@(emp.Status == "ACTIVE" ? "background:#dcfce7;color:#166534" : "background:#f1f5f9;color:#475569") ; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600;">
                                    @(emp.Status == "ACTIVE" ? "Hoạt động" : "Đã nghỉ")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    
    <div class="mb-4">
        <h4 class="fw-bold mb-0">Xin chào, @User.Identity?.Name!</h4>
        <p class="text-muted">Chọn mục bên trái để xem thông tin của bạn.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <a asp-controller="Profile" asp-action="Index" class="stat-card d-flex">
                <div class="stat-icon blue"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
                <div><div class="stat-label fw-semibold" style="font-size:15px">Hồ sơ của tôi</div><div class="stat-label">Xem thông tin cá nhân</div></div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Contract" asp-action="Index" class="stat-card d-flex">
                <div class="stat-icon yellow"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
                <div><div class="stat-label fw-semibold" style="font-size:15px">Hợp đồng của tôi</div><div class="stat-label">Xem hợp đồng lao động</div></div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="EmployeeAllowance" asp-action="Index" class="stat-card d-flex">
                <div class="stat-icon green"><svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                <div><div class="stat-label fw-semibold" style="font-size:15px">Phụ cấp của tôi</div><div class="stat-label">Xem phụ cấp nhận được</div></div>
            </a>
        </div>
    </div>
}

@section Scripts {
    @if (isHr)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
            const labels       = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GrowthLabels));
            const headcount    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HeadcountData));
            const deptNames    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptNames));
            const deptHires    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptMonthlyHires));

            const palette = ['#3b82f6','#10b981','#f59e0b','#ec4899','#8b5cf6','#06b6d4'];

            
            new Chart(document.getElementById('growthChart'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Tổng nhân viên',
                        data: headcount,
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59,130,246,.10)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#3b82f6',
                        pointRadius: 4
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: '#f3f4f6' }, ticks: { font: { size: 12 } } },
                        y: { grid: { color: '#f3f4f6' }, ticks: { font: { size: 12 }, precision: 0 }, beginAtZero: false }
                    }
                }
            });

            
            new Chart(document.getElementById('deptChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: deptNames.map((name, i) => ({
                        label: name,
                        data: deptHires[i],
                        backgroundColor: palette[i % palette.length],
                        borderRadius: 4,
                        stack: 'hires'
                    }))
                },
                options: {
                    plugins: { legend: { position: 'bottom', labels: { font: { size: 12 }, padding: 12, boxWidth: 12 } } },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 12 } }, stacked: true },
                        y: { grid: { color: '#f3f4f6' }, ticks: { font: { size: 12 }, precision: 0 }, stacked: true, beginAtZero: true }
                    }
                }
            });
        </script>
    }
}
