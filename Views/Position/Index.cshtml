@model PositionIndexViewModel
@{
    ViewData["Title"] = "Quản lý Chức vụ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Quản lý Chức vụ</h4>
    <button id="posCreateBtn" type="button" class="btn btn-primary">+ Thêm chức vụ</button>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="keyword" value="@Model.SearchKeyword"
               class="form-control" placeholder="Tìm theo tên hoặc mã..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Tìm kiếm</button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword))
        {
            <a asp-action="Index" class="btn btn-icon btn-outline-secondary" title="Xóa bộ lọc">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </a>
        }
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="">
                <tr>
                    <th>Mã CV</th>
                    <th>Tên chức vụ</th>
                    <th>Cấp bậc</th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th style="width:108px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pos in Model.Positions)
                {
                    <tr>
                        <td><code>@pos.Code</code></td>
                        <td class="fw-semibold">@pos.Name</td>
                        <td>
                            @{
                                var (badgeClass, levelText) = pos.Level switch
                                {
                                    "SENIOR" => ("badge-terminated", "Senior"),
                                    "MIDDLE" => ("badge-expired", "Middle"),
                                    _ => ("badge-probation", "Junior")
                                };
                            }
                            <span class="badge @badgeClass">@levelText</span>
                        </td>
                        <td class="text-muted">@(pos.Description ?? "--")</td>
                        <td>
                            <span class="badge @(pos.Status == "ACTIVE" ? "badge-active" : "badge-inactive")">
                                @(pos.Status == "ACTIVE" ? "Hoạt động" : "Không HĐ")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@pos.Id"
                               class="btn btn-icon btn-outline-secondary" title="Xem chi tiết">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                            <button type="button" class="btn btn-icon btn-outline-primary posEditBtn" title="Sửa"
                                    data-id="@pos.Id" data-code="@pos.Code" data-name="@pos.Name"
                                    data-level="@pos.Level" data-desc="@(pos.Description ?? "")">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <form asp-action="ToggleStatus" asp-route-id="@pos.Id"
                                  method="post" class="toggle-form"
                                  onsubmit="return confirm('@(pos.Status == "ACTIVE" ? "Vô hiệu hóa chức vụ này?" : "Kích hoạt lại chức vụ này?")')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="toggle-btn @(pos.Status == "ACTIVE" ? "is-on" : "")"
                                        title="@(pos.Status == "ACTIVE" ? "Đang hoạt động — nhấn để vô hiệu hóa" : "Đang tắt — nhấn để kích hoạt")">
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Positions.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">Dữ liệu trống</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", new ViewDataDictionary(ViewData) {
        { "Page", Model.Page }, { "TotalPages", Model.TotalPages },
        { "TotalCount", Model.TotalCount }, { "PageSize", Model.PageSize }
    })
</div>

<div class="modal fade" id="posModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px">
            <div class="modal-header"><h5 class="modal-title" id="posModalTitle"></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body p-4">
                <form id="posForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="posId" name="Id" />
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Mã chức vụ <span class="text-danger">*</span></label>
                            <input id="posCode" name="Code" class="form-control" placeholder="VD: DEV, PM" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Tên chức vụ <span class="text-danger">*</span></label>
                            <input id="posName" name="Name" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Cấp bậc</label>
                            <select id="posLevel" name="Level" class="form-select">
                                <option value="JUNIOR">Junior (Mới vào)</option>
                                <option value="MIDDLE">Middle (Có kinh nghiệm)</option>
                                <option value="SENIOR">Senior (Cấp cao)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Mô tả</label>
                            <textarea id="posDesc" name="Description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 pt-3 border-top">
                        <button type="submit" id="posSubmitBtn" class="btn btn-primary px-4">Lưu</button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const modal = new bootstrap.Modal(document.getElementById('posModal'));
    document.getElementById('posCreateBtn').addEventListener('click', function () {
        document.getElementById('posModalTitle').textContent = 'Thêm chức vụ mới';
        document.getElementById('posId').value = '';
        document.getElementById('posCode').value = '';
        document.getElementById('posName').value = '';
        document.getElementById('posLevel').value = 'JUNIOR';
        document.getElementById('posDesc').value = '';
        document.getElementById('posSubmitBtn').textContent = 'Lưu';
        modal.show();
    });
    document.querySelectorAll('.posEditBtn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('posModalTitle').textContent = 'Chỉnh sửa chức vụ';
            document.getElementById('posId').value = this.dataset.id;
            document.getElementById('posCode').value = this.dataset.code;
            document.getElementById('posName').value = this.dataset.name;
            document.getElementById('posLevel').value = this.dataset.level;
            document.getElementById('posDesc').value = this.dataset.desc;
            document.getElementById('posSubmitBtn').textContent = 'Cập nhật';
            modal.show();
        });
    });
    document.getElementById('posForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const id = document.getElementById('posId').value;
        const payload = {
            code: document.getElementById('posCode').value,
            name: document.getElementById('posName').value,
            level: document.getElementById('posLevel').value,
            description: document.getElementById('posDesc').value || null
        };
        const url = id ? '/api/positions/' + id : '/api/positions';
        const method = id ? 'PUT' : 'POST';
        try {
            const res = await fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            if (res.ok) { window.location.reload(); }
            else { const d = await res.json(); alert(d.error || 'Có lỗi xảy ra'); }
        } catch { alert('Có lỗi kết nối'); }
    });
    document.querySelectorAll('.toggle-form').forEach(function (form) {
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const parts = this.action.split('/');
            const id = parts[parts.length - 1];
            try {
                const res = await fetch('/api/positions/' + id + '/toggle', { method: 'PATCH' });
                if (res.ok) { window.location.reload(); }
                else { const d = await res.json(); alert(d.error || 'Có lỗi xảy ra'); }
            } catch { alert('Có lỗi kết nối'); }
        });
    });
}());
</script>
}
