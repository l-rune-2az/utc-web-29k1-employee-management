@model PositionFormViewModel
@{
    bool isEdit = Model.Id != Guid.Empty;
    string action = isEdit ? "Edit" : "Create";
}
<form asp-action="@action" asp-route-id="@(isEdit ? Model.Id.ToString() : null)"
      method="post">
    @Html.AntiForgeryToken()

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="Code" class="form-label">Mã chức vụ</label>
            <input asp-for="Code" class="form-control" placeholder="VD: DEV, PM" />
            <span asp-validation-for="Code" class="text-danger" style="font-size:12px"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Name" class="form-label">Tên chức vụ</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger" style="font-size:12px"></span>
        </div>
        <div class="col-12">
            <label asp-for="Level" class="form-label">Cấp bậc</label>
            <select asp-for="Level" asp-items="Model.LevelOptions" class="form-select"></select>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="d-flex gap-2 pt-3 border-top">
        <button type="submit" class="btn btn-primary px-4">@(isEdit ? "Cập nhật" : "Lưu")</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
    </div>
</form>