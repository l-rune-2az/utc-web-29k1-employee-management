<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HRM System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-50: #eff6ff; --primary-600: #2563eb; --primary-700: #1d4ed8;
            --gray-50: #f8fafc;    --gray-100: #f1f5f9;   --gray-200: #e2e8f0;
            --gray-400: #94a3b8;   --gray-500: #64748b;   --gray-600: #475569;
            --gray-800: #1e293b;
        }
        body { background: var(--gray-100); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

        
        .hrm-navbar {
            position: fixed; top: 0; left: 0; right: 0; z-index: 200; height: 64px;
            background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--gray-200); box-shadow: 0 1px 2px rgba(0,0,0,.05);
            display: flex; align-items: center; padding: 0 24px; justify-content: space-between;
        }
        .hrm-brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
        .hrm-logo {
            width: 36px; height: 36px; border-radius: 8px;
            background: linear-gradient(135deg,#3b82f6,#1d4ed8);
            display: flex; align-items: center; justify-content: center;
        }
        .hrm-logo svg { width: 20px; height: 20px; stroke: #fff; fill: none; stroke-width: 2; }
        .hrm-title {
            font-size: 18px; font-weight: 700;
            background: linear-gradient(135deg,#3b82f6,#1d4ed8);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .hrm-nav-right { display: flex; align-items: center; gap: 16px; }
        .hrm-avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: linear-gradient(135deg,#3b82f6,#1d4ed8);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 13px; font-weight: 700; flex-shrink: 0;
        }
        .hrm-user-name  { font-size: 14px; font-weight: 600; color: var(--gray-800); line-height: 1.3; }
        .hrm-user-role  { font-size: 12px; color: var(--gray-500); }
        .btn-logout {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 14px; border: 1.5px solid var(--gray-200); border-radius: 8px;
            background: transparent; font-size: 13px; color: var(--gray-600);
            cursor: pointer; font-weight: 500; transition: all .15s; font-family: inherit;
        }
        .btn-logout:hover { background: #fef2f2; border-color: #dc2626; color: #dc2626; }
        .btn-logout svg  { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; }

        
        .hrm-sidebar {
            position: fixed; top: 64px; left: 0; bottom: 0; width: 240px;
            background: #fff; border-right: 1px solid var(--gray-200);
            z-index: 100; overflow-y: auto; padding-bottom: 24px;
        }
        .nav-section {
            padding: 16px 16px 4px;
            font-size: 11px; font-weight: 600; color: var(--gray-400);
            text-transform: uppercase; letter-spacing: .08em;
        }
        .hrm-nav-link {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 12px; margin: 1px 8px;
            border-radius: 8px; color: var(--gray-600); font-size: 14px;
            text-decoration: none; transition: all .15s; font-weight: 500;
        }
        .hrm-nav-link svg { width: 17px; height: 17px; stroke: currentColor; fill: none; stroke-width: 2; flex-shrink: 0; }
        .hrm-nav-link:hover  { background: var(--gray-50);    color: var(--gray-800); }
        .hrm-nav-link.active { background: var(--primary-50); color: var(--primary-600); font-weight: 600; }

        
        .hrm-main { margin-left: 240px; margin-top: 64px; padding: 24px; min-height: calc(100vh - 64px); }

        
        .card { border-radius: 12px !important; overflow: hidden; border: 1px solid #e5e7eb !important; }
        .table { background: #fff; margin: 0; }
        .table > thead { background: #f1f5f9; }
        .table > thead > tr > th {
            color: #374151; font-size: 12px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .04em;
            padding: 11px 16px; border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }
        code {
            color: #2563eb; font-weight: 700; font-size: 13px;
            background: #eff6ff; padding: 2px 7px; border-radius: 5px;
            font-family: 'SFMono-Regular', Consolas, monospace;
        }
        .table > tbody > tr > td {
            padding: 11px 16px; vertical-align: middle;
            border-bottom: 1px solid #f3f4f6; font-size: 14px; color: #374151;
        }
        .table > tbody > tr:last-child > td { border-bottom: none; }
        .table-hover > tbody > tr:hover > * { background: #f9fafb !important; }
        .table form.d-inline { display: inline !important; vertical-align: middle; }
        .table td:last-child  { white-space: nowrap; }

        
        .btn { border-radius: 8px !important; font-weight: 500; transition: all .18s !important; }
        .btn-primary {
            background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
            border: none !important; box-shadow: 0 4px 12px rgba(37,99,235,.25) !important;
            font-weight: 600 !important;
        }
        .btn-primary:hover { background: linear-gradient(135deg, #2563eb, #1d4ed8) !important;
            transform: translateY(-1px); box-shadow: 0 6px 18px rgba(37,99,235,.35) !important; }
        .btn-outline-secondary {
            border-color: #e5e7eb !important; color: #6b7280 !important; background: #fff !important;
        }
        .btn-outline-secondary:hover { background: #f9fafb !important; border-color: #d1d5db !important; }
        
        .btn-icon {
            display: inline-flex; align-items: center; justify-content: center;
            width: 30px; height: 30px; padding: 0; border-radius: 8px !important;
            border: none !important; transition: all .15s !important;
        }
        .btn-icon:hover { transform: translateY(-1px); filter: brightness(.93); }
        .btn-icon svg { width: 14px; height: 14px; }
        .btn-icon.btn-outline-primary { background: #eff6ff !important; color: #2563eb !important; }
        .btn-icon.btn-outline-danger  { background: #fef2f2 !important; color: #dc2626 !important; }
        .btn-icon.btn-outline-success { background: #f0fdf4 !important; color: #16a34a !important; }
        
        .toggle-form { display: inline-flex; vertical-align: middle; }
        .toggle-btn {
            position: relative; display: inline-flex; align-items: center;
            width: 40px; height: 22px; border: none; border-radius: 11px;
            padding: 0; cursor: pointer; transition: background .2s;
            background: #cbd5e1;
        }
        .toggle-btn.is-on  { background: #22c55e; }
        .toggle-btn::after {
            content: ''; position: absolute; left: 3px;
            width: 16px; height: 16px; border-radius: 50%;
            background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.25);
            transition: left .2s;
        }
        .toggle-btn.is-on::after { left: 21px; }
        .toggle-btn:hover { filter: brightness(.93); }

        
        .badge-active     { background: #dcfce7; color: #166534; }
        .badge-inactive   { background: #f1f5f9; color: #475569; }
        .badge-expired    { background: #fffbeb; color: #d97706; }
        .badge-terminated { background: #fef2f2; color: #dc2626; }
        .badge-probation  { background: #eff6ff; color: #2563eb; }
        .badge-official   { background: #f0fdf4; color: #059669; }
        .badge { display:inline-flex; align-items:center; padding:3px 10px;
                 border-radius:9999px; font-size:12px; font-weight:600; }

        
        .form-control, .form-select {
            border: 2px solid #cbd5e1 !important; border-radius: 8px !important;
            height: 40px; font-size: 14px; color: #0f172a;
            transition: all .18s;
        }
        .form-control:focus, .form-select:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 4px rgba(59,130,246,.10) !important;
        }
        textarea.form-control { height: auto; }

        
        .form-label { font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 5px; }
        .form-section { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #94a3b8; padding-bottom: 8px; margin-bottom: 16px; border-bottom: 1px solid #e2e8f0; }
        .guide-card .card-header { background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 14px 20px; }
        .guide-card .card-body  { padding: 20px; }
        .guide-item { display: flex; gap: 10px; margin-bottom: 14px; font-size: 13px; color: #64748b; line-height: 1.55; }
        .guide-item:last-child  { margin-bottom: 0; }
        .guide-item svg { flex-shrink: 0; margin-top: 2px; }

        
        .pagination { gap: 3px; margin: 0; }
        .page-link {
            min-width: 32px; height: 32px;
            display: inline-flex; align-items: center; justify-content: center;
            padding: 0 8px; border-radius: 8px !important;
            border: 1.5px solid #e2e8f0 !important;
            font-size: 13px; font-weight: 500; color: #475569;
            background: #fff; line-height: 1; transition: all .15s;
        }
        .page-link:hover { background: #f1f5f9; border-color: #94a3b8 !important; color: #1e293b; }
        .page-item.active .page-link {
            background: #2563eb !important; border-color: #2563eb !important;
            color: #fff !important; box-shadow: 0 2px 8px rgba(37,99,235,.30);
        }
        .page-item.disabled .page-link {
            background: #f8fafc; color: #cbd5e1; border-color: #f1f5f9 !important;
        }

        
        .toast-wrap { position: fixed; top: 80px; right: 20px; z-index: 1100; min-width: 280px; }

        
        .hrm-hamburger {
            display: none; background: none; border: none; padding: 6px;
            cursor: pointer; color: var(--gray-600); border-radius: 6px;
        }
        .hrm-hamburger:hover { background: var(--gray-100); }
        .hrm-hamburger svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 2; }
        .hrm-overlay {
            display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4);
            z-index: 99; backdrop-filter: blur(2px);
        }
        .hrm-overlay.show { display: block; }

        @@media (max-width: 991px) {
            .hrm-hamburger { display: flex; align-items: center; }
            .hrm-sidebar {
                transform: translateX(-100%); transition: transform .25s ease;
                z-index: 150;
            }
            .hrm-sidebar.open { transform: translateX(0); }
            .hrm-main { margin-left: 0 !important; padding: 16px; }
        }
        @@media (max-width: 767px) {
            .hrm-navbar { padding: 0 14px; }
            .hrm-title { font-size: 15px; }
            .hrm-user-name, .hrm-user-role { display: none; }
            .hrm-main { padding: 12px; }
            .row-cols-2 > .col { padding: 6px; }
            
            .col-lg-7, .col-lg-8 { width: 100% !important; }
            .col-lg-5, .col-lg-4 { width: 100% !important; }
        }
        @@media (max-width: 575px) {
            h4 { font-size: 18px; }
            .d-flex.justify-content-between { flex-wrap: wrap; gap: 10px; }
            .btn-primary { font-size: 13px; padding: 7px 14px; }
        }
    </style>
</head>
@{
    string _name     = User.Identity?.Name ?? "";
    string _initials = _name.Length > 0 ? _name[0].ToString().ToUpper() : "?";
    string _role     = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    string _ctrl     = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<body>

<div class="hrm-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
<nav class="hrm-navbar">
    <div class="d-flex align-items-center gap-2">
        <button class="hrm-hamburger" id="hamburgerBtn" onclick="toggleSidebar()" aria-label="Menu">
            <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <a class="hrm-brand" asp-controller="Home" asp-action="Index">
            <div class="hrm-logo">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span class="hrm-title">UTC HRM</span>
        </a>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="hrm-nav-right">
            <div class="d-flex align-items-center gap-2">
                <div class="hrm-avatar">@_initials</div>
                <div>
                    <div class="hrm-user-name">@_name</div>
                    <div class="hrm-user-role">@(_role == "HR_MANAGER" ? "HR Manager" : "Nhân viên")</div>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Đăng xuất
                </button>
            </form>
        </div>
    }
</nav>

@if (User.Identity?.IsAuthenticated == true)
{
    <aside class="hrm-sidebar">
        <span class="nav-section">Tổng quan</span>
        <a class="hrm-nav-link @(_ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Dashboard
        </a>

        @if (User.IsInRole("HR_MANAGER"))
        {
            <span class="nav-section">Tổ chức</span>
            <a class="hrm-nav-link @(_ctrl == "Department" ? "active" : "")" asp-controller="Department" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Phòng ban
            </a>
            <a class="hrm-nav-link @(_ctrl == "Position" ? "active" : "")" asp-controller="Position" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Chức vụ
            </a>

            <span class="nav-section">Nhân sự</span>
            <a class="hrm-nav-link @(_ctrl == "Employee" ? "active" : "")" asp-controller="Employee" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Nhân viên
            </a>
            <a class="hrm-nav-link @(_ctrl == "Contract" ? "active" : "")" asp-controller="Contract" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Hợp đồng
            </a>
            <a class="hrm-nav-link @(_ctrl == "Dependent" ? "active" : "")" asp-controller="Dependent" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                Người phụ thuộc
            </a>

            <span class="nav-section">Phụ cấp</span>
            <a class="hrm-nav-link @(_ctrl == "AllowanceConfig" ? "active" : "")" asp-controller="AllowanceConfig" asp-action="Index">
                <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Danh mục phụ cấp
            </a>
            <a class="hrm-nav-link @(_ctrl == "EmployeeAllowance" ? "active" : "")" asp-controller="EmployeeAllowance" asp-action="Index">
                <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                Phụ cấp NV
            </a>
        }

        @if (User.IsInRole("EMPLOYEE"))
        {
            <span class="nav-section">Cá nhân</span>
            <a class="hrm-nav-link @(_ctrl == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Hồ sơ của tôi
            </a>
            <a class="hrm-nav-link @(_ctrl == "Contract" ? "active" : "")" asp-controller="Contract" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Hợp đồng của tôi
            </a>
            <a class="hrm-nav-link @(_ctrl == "EmployeeAllowance" ? "active" : "")" asp-controller="EmployeeAllowance" asp-action="Index">
                <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                Phụ cấp của tôi
            </a>
            <a class="hrm-nav-link @(_ctrl == "Dependent" ? "active" : "")" asp-controller="Dependent" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                Người phụ thuộc
            </a>
        }
    </aside>
}

<div class="hrm-main">
    <div class="toast-wrap">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>
    <main role="main">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<script>
    function toggleSidebar() {
        const sidebar = document.querySelector('.hrm-sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        if (!sidebar) return;
        sidebar.classList.toggle('open');
        overlay.classList.toggle('show');
    }
    function closeSidebar() {
        document.querySelector('.hrm-sidebar')?.classList.remove('open');
        document.getElementById('sidebarOverlay')?.classList.remove('show');
    }
    
    document.querySelectorAll('.hrm-nav-link').forEach(el =>
        el.addEventListener('click', () => {
            if (window.innerWidth < 992) closeSidebar();
        })
    );
</script>
</body>
</html>
